{
    "name": "bundle-framework-naming",
    "displayName": "Bundle Framework Naming",
    "description": "Live Luau naming diagnostics from the project-installed Bundle Framework tooling.",
    "version": "0.1.0",
    "publisher": "bundle-framework",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Lucky/bundle-framework"
    },
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": ["Linters"],
    "files": ["extension.js", "package.json", "LICENSE"],
    "activationEvents": ["onLanguage:luau"],
    "main": "./extension.js",
    "contributes": {
        "configuration": {
            "title": "Bundle Framework Naming",
            "properties": {
                "bundleFramework.naming.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Publish project naming diagnostics while editing Luau files."
                },
                "bundleFramework.naming.lunePath": {
                    "type": "string",
                    "default": "lune",
                    "description": "Path to the Lune executable used to run the project-owned Luau analyzer."
                }
            }
        }
    },
    "scripts": {
        "package": "vsce package --no-dependencies --out bundle-framework-naming.vsix"
    },
    "devDependencies": {
        "@vscode/vsce": "4.0.0"
    }
}