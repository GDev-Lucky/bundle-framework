{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build project...",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tooling\\build.ps1"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Format check",
            "type": "shell",
            "command": "stylua",
            "args": ["--check", "src", "examples", "tooling"],
            "problemMatcher": []
        },
        {
            "label": "Lint check",
            "type": "shell",
            "command": "npm",
            "args": ["run", "check"],
            "problemMatcher": {
                "owner": "bundle-framework-linter",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+): (.*) \\[(.*)\\]$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4,
                    "code": 5
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
