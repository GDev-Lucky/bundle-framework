{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format check",
            "type": "shell",
            "command": "stylua",
            "args": ["--check", "src", "examples", "tooling"],
            "problemMatcher": []
        },
        {
            "label": "Naming check",
            "type": "shell",
            "command": "lune",
            "args": ["run", "tooling/naming/cli.luau", "check", "src", "examples", "tooling"],
            "problemMatcher": {
                "owner": "bundle-framework-naming",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+): (.*) \\[(.*)\\]$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4,
                    "code": 5
                }
            }
        },
        {
            "label": "Build example",
            "type": "shell",
            "command": "rojo",
            "args": ["build", "example.project.json", "--output", "bundle-framework-example.rbxlx"],
            "problemMatcher": []
        },
        {
            "label": "Build package",
            "type": "shell",
            "command": "rojo",
            "args": ["build", "package.project.json", "--output", "bundle-framework.rbxm"],
            "problemMatcher": []
        }
    ]
}